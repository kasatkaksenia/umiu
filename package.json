{
  "name": "umiu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cap:sync": "npm run build:native && cap sync",
    "dev:phone": "vite --host",
    "qa:nav": "node qa/nav.mjs",
