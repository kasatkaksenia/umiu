    "@fontsource/montserrat": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/urbanist": "5.2.6",
    "@ionic/react": "8.8.19",
    "@ionic/react-router": "8.8.19",
    "html5-qrcode": "2.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "18.3.12",
